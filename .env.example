# Copy to .env and fill in real values. .env is gitignored -- never commit it
# (see .gitignore's note: this repository is private, so GitHub secret
# scanning is off, and .env.example plus discipline are the only guard).

# Neon Postgres -- POOLED endpoint only. The hostname must contain "-pooler."
# (Neon's PgBouncer endpoint). The direct endpoint is not usable here -- see
# src/shared/db/pooled-connection.ts and design.md D2.
DATABASE_URL="postgresql://user:password@ep-example-12345-pooler.us-east-2.aws.neon.tech/rentas?sslmode=require"

# Auth.js v5 -- generate with `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET="replace-with-a-generated-secret"

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID="replace-with-google-oauth-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-oauth-client-secret"

PHONE_VERIFICATION_ENABLED=false

# Cloudflare R2 (design.md D2/D12). Region is always "auto".
R2_BUCKET="rentas-photos"
R2_BUCKET_URL="https://replace-with-account-id.r2.cloudflarestorage.com"
R2_BUCKET_PUBLIC_URL="https://replace-with-subdomain.r2.dev"
R2_BUCKET_ACCOUNT_ID="replace-me"
R2_BUCKET_ACCESS_KEY="replace-me"
R2_BUCKET_SECRET_KEY="replace-me"

RESEND_API_KEY="replace-with-resend-api-key"
# El remitente. Su dominio TIENE que estar verificado en Resend o todo rebota,
# y la clave sola no alcanza. Sin esta variable la ruta del trabajo contesta
# 500 `mailer_not_configured` en vez de empezar una tanda que no puede enviar.
LIFECYCLE_MAIL_FROM="avisos@replace-with-verified-domain"
# El remitente del enlace mágico (tasks.md 15.2). Variable propia, aparte de
# LIFECYCLE_MAIL_FROM: el remitente de "entrá con este enlace" es una
# decisión de identity, no la del correo de vencimiento de listing-lifecycle.
# Misma clave de cuenta (RESEND_API_KEY), mismo dominio verificado. Sin esto,
# sendVerificationRequest falla cerrado en vez de fingir que mandó el correo.
AUTH_MAIL_FROM="ingresa@replace-with-verified-domain"
