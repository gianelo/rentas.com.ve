# Copiá a .env y poné los valores reales. .env está en .gitignore -- nunca se
# commitea (ver la nota de .gitignore: este repositorio es privado, así que el
# escaneo de secretos de GitHub está apagado, y este archivo más la disciplina
# son la única guardia).

# ── Base de datos ────────────────────────────────────────────────────────────

# Neon Postgres -- SOLO el endpoint POOLED. El host tiene que contener
# "-pooler." (el endpoint PgBouncer de Neon). El directo no sirve acá:
# src/shared/db/pooled-connection.ts y design.md D2.
DATABASE_URL="postgresql://user:password@ep-example-12345-pooler.us-east-2.aws.neon.tech/rentas?sslmode=require"

# Postgres de Docker para `pnpm test:integration`. Puerto 5433 a propósito,
# para no pisar un Postgres local en el 5432.
TEST_DATABASE_URL="postgresql://user:password@localhost:5433/rentas_test"

# ── Identidad ────────────────────────────────────────────────────────────────

# Auth.js v5 -- generalo con `npx auth secret` u `openssl rand -base64 33`.
AUTH_SECRET="replace-with-a-generated-secret"

# Cliente OAuth de Google (Google Cloud Console > APIs & Services >
# Credentials). URI de redirección autorizada: <origin>/api/auth/callback/google
# Auth.js las descubre POR NOMBRE: no aparecen en el código, y por eso una
# búsqueda de `process.env` no las encuentra.
AUTH_GOOGLE_ID="replace-with-google-oauth-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-oauth-client-secret"

# Apaga la verificación de teléfono en local. En producción va SIEMPRE false
# hasta que exista el proveedor: src/modules/identity/infrastructure/phone-verification-adapter.ts
PHONE_VERIFICATION_ENABLED=false

# ── Fotos ────────────────────────────────────────────────────────────────────

# Cloudflare R2 (design.md D2/D12). La región es siempre "auto".
R2_BUCKET="rentas-photos"
R2_BUCKET_URL="https://replace-with-account-id.r2.cloudflarestorage.com"
R2_BUCKET_PUBLIC_URL="https://replace-with-subdomain.r2.dev"
R2_BUCKET_ACCOUNT_ID="replace-me"
R2_BUCKET_ACCESS_KEY="replace-me"
R2_BUCKET_SECRET_KEY="replace-me"

# ── Correo ───────────────────────────────────────────────────────────────────

RESEND_API_KEY="replace-with-resend-api-key"

# El remitente de los avisos de vencimiento. Su dominio TIENE que estar
# verificado en Resend o todo rebota, y la clave sola no alcanza. Sin esto la
# ruta del trabajo contesta 500 `mailer_not_configured` en vez de empezar una
# tanda que no puede enviar.
LIFECYCLE_MAIL_FROM="avisos@replace-with-verified-domain"

# El remitente del enlace mágico (tasks.md 15.2). Variable propia, aparte de
# LIFECYCLE_MAIL_FROM: el remitente de "entrá con este enlace" es una decisión
# de identity, no la del correo de vencimiento. Misma clave de cuenta, mismo
# dominio verificado. Sin esto, sendVerificationRequest falla cerrado en vez de
# fingir que mandó el correo.
AUTH_MAIL_FROM="ingresa@replace-with-verified-domain"

# El sitio, SIN barra final. Los enlaces del correo son absolutos y se arman
# con esto: si falta, el de renovación llega apuntando a ninguna parte.
SITE_BASE_URL="https://rentas.com.ve"

# ── Secretos de ruta ─────────────────────────────────────────────────────────

# Firma los enlaces de renovación que viajan por correo (HMAC-SHA256). Sin
# esto /renovar contesta 500 en vez de aceptar un enlace sin verificar.
RENEWAL_TOKEN_SECRET="replace-with-a-generated-secret"

# Autoriza el trabajo de vencimientos y recordatorios (/api/jobs/*). Sin esto
# la ruta queda CERRADA: no hay error visible, el trabajo simplemente no corre
# y los avisos vencen sin avisarle a nadie.
CRON_SECRET="replace-with-a-generated-secret"

# Autoriza restaurar un aviso ocultado por reportes (/api/operator/*). Es la
# ÚNICA puerta de vuelta: sin esto, tres reportes ocultan un aviso legítimo y
# no hay forma de levantarlo.
OPERATOR_SECRET="replace-with-a-generated-secret"

# ── Herramientas ─────────────────────────────────────────────────────────────

# Abre /measure, el arnés que mide cajas renderizadas (`pnpm test:measure`).
# No se enciende en producción: es una pantalla que no es del producto.
MEASURE_HARNESS_ENABLED=false

# VACÍA A PROPÓSITO -- es la escotilla de emergencia, no un ajuste.
# scripts/deploy-migrate.mjs FRENA el despliegue cuando una migración trae
# DROP TABLE/COLUMN, TRUNCATE o DELETE FROM. Encenderla acá desarmaría ese
# guardia para TODAS las migraciones que vengan después, y el propio script
# explica por qué: "una variable de entorno es invisible en la revisión, se
# pone una vez y se olvida". El camino normal es el marcador dentro del .sql,
# que desarma exactamente un archivo. Se pone en producción, para un solo
# despliegue, y con respaldo tomado antes.
# ALLOW_DESTRUCTIVE_MIGRATION=
